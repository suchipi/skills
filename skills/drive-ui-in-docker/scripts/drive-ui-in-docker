#!/usr/bin/env bash
# drive-ui-in-docker — build/run a docker-novnc container and drive+observe the UI inside it.
#
# All commands share one container ($NAME) and one host<->container work dir:
#   host  $WORK   <->  container /work
# Screenshots, recordings, and suchibot scripts live there, so the host can
# Read the images and drop scripts in without docker cp.
#
# Usage:
#   drive-ui-in-docker build                   Build the image from the skill's Dockerfile
#   drive-ui-in-docker up [WxH]                 Start the bare VNC desktop (default 1280x800)
#   drive-ui-in-docker launch <cmd...>          Launch a UI app inside the running desktop (detached)
#   drive-ui-in-docker shot [name.png]          Grab the screen -> $WORK/name.png (default shot.png)
#   drive-ui-in-docker record-start [name.flv]  Start screen recording -> $WORK/name.flv (watch live)
#   drive-ui-in-docker record-stop              Stop the recorder (the .flv is already complete)
#   drive-ui-in-docker run <script.js>          Run a suchibot script inside the container
#   drive-ui-in-docker exec <cmd...>            Run an arbitrary command inside the container (DISPLAY=:0)
#   drive-ui-in-docker shell                    Interactive shell inside the container
#   drive-ui-in-docker vncshot [name.jpg]       Alternative capture via vncsnapshot over VNC (:5900)
#   drive-ui-in-docker status                   Show container + work-dir state
#   drive-ui-in-docker down                     Stop the container (preserved; resume fast with 'up')
#   drive-ui-in-docker destroy                  Remove the container entirely (cleanup when done)
#
# Env overrides: DRIVE_UI_IN_DOCKER_NAME (drive-ui-in-docker),
#                DRIVE_UI_IN_DOCKER_IMAGE (drive-ui-in-docker:latest),
#                DRIVE_UI_IN_DOCKER_WORK (.tmp/drive-ui-in-docker)
#                DRIVE_UI_IN_DOCKER_NO_PORTS (unset; if set, don't publish host
#                  ports — lets several differently-named containers run at once)
set -euo pipefail

NAME="${DRIVE_UI_IN_DOCKER_NAME:-drive-ui-in-docker}"
IMAGE="${DRIVE_UI_IN_DOCKER_IMAGE:-drive-ui-in-docker:latest}"
SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
WORK="${DRIVE_UI_IN_DOCKER_WORK:-.tmp/drive-ui-in-docker}"
mkdir -p "$WORK"
WORK_ABS="$(cd "$WORK" && pwd)"

die() { echo "drive-ui-in-docker: $*" >&2; exit 1; }
running() { [ -n "$(docker ps -q -f "name=^${NAME}$")" ]; }
exists()  { [ -n "$(docker ps -aq -f "name=^${NAME}$")" ]; }
require_up() { running || die "container '$NAME' is not running. Run: drive-ui-in-docker up"; }

# Detect the live X display geometry (e.g. 1280x800) from inside the container.
# awk reads all input (no early `exit`) so xdpyinfo never gets SIGPIPE, which
# under `set -o pipefail` would otherwise fail this function despite printing.
disp_size() {
  docker exec "$NAME" xdpyinfo -display :0 \
    | awk '/dimensions:/ && !seen {print $2; seen=1}'
}

# Block until the X server on :0 answers (used after 'docker start').
wait_x() {
  local i
  for i in $(seq 1 30); do
    docker exec "$NAME" xdpyinfo -display :0 >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  return 1
}

# Set the live display to WxH via RandR. Uses a preset mode when TigerVNC lists
# one, otherwise synthesizes a modeline (Xvnc is virtual, so the timings are
# cosmetic — only the WxH matters).
apply_geometry() {
  local geom="$1"
  local w="${geom%x*}" h="${geom#*x}"
  docker exec -e DISPLAY=:0 "$NAME" sh -c '
    set -e
    G="'"$geom"'"; W='"$w"'; H='"$h"'
    OUT=$(xrandr -q | awk "/ connected/{print \$1; exit}")
    if ! xrandr -q | grep -qw "$G"; then
      CLK=$(( (W+24)*(H+8)*60/1000000 )); [ "$CLK" -lt 1 ] && CLK=1
      xrandr --newmode "$G" ${CLK}.00 \
        $W $((W+8)) $((W+16)) $((W+24)) $H $((H+2)) $((H+4)) $((H+8)) +hsync +vsync
      xrandr --addmode "$OUT" "$G"
    fi
    xrandr --output "$OUT" --mode "$G"
  '
}

cmd_build() {
  docker build -t "$IMAGE" "$SKILL_DIR"
}

cmd_up() {
  running && die "container '$NAME' already running (use 'down' to stop, 'destroy' to remove)"
  # Reuse a stopped container so anything installed in it (apt packages, etc.)
  # survives across sessions — only 'destroy' deletes that state.
  if exists; then
    docker start "$NAME" >/dev/null
    if [ -n "${1:-}" ]; then
      wait_x || die "resumed '$NAME' but the X server never came up"
      apply_geometry "$1" || die "resumed '$NAME' but failed to set resolution $1"
      echo "Resumed existing '$NAME' at $1 — installed apps & state preserved. View: http://localhost:8080/"
    else
      echo "Resumed existing '$NAME' — installed apps & state preserved. View: http://localhost:8080/"
    fi
    return
  fi
  local geom="${1:-1280x800}"
  local w="${geom%x*}" h="${geom#*x}"
  # Host ports can only be bound once, so suppress publishing (NO_PORTS) when
  # running several containers in parallel — capture still works over the
  # in-container VNC/X server, only the browser view URL goes away.
  local ports="-p 8080:8080 -p 5900:5900"
  [ -n "${DRIVE_UI_IN_DOCKER_NO_PORTS:-}" ] && ports=""
  docker run -d \
    --name "$NAME" \
    --shm-size=512m \
    $ports \
    -e DISPLAY_WIDTH="$w" -e DISPLAY_HEIGHT="$h" \
    -v "$WORK_ABS:/work" \
    "$IMAGE" >/dev/null
  echo "Created '$NAME' at ${geom}. View the desktop at http://localhost:8080/"
  echo "Work dir: $WORK_ABS <-> /work"
}

cmd_launch() {
  require_up
  [ "$#" -ge 1 ] || die "launch needs a command, e.g. drive-ui-in-docker launch xterm"
  docker exec -d -e DISPLAY=:0 "$NAME" "$@"
  echo "Launched inside '$NAME': $*"
}

cmd_shot() {
  require_up
  local name="${1:-shot.png}"
  local size; size="$(disp_size)"
  docker exec -e DISPLAY=:0 "$NAME" \
    ffmpeg -y -loglevel error -f x11grab -draw_mouse 1 \
      -video_size "$size" -i :0.0 -frames:v 1 "/work/$name"
  echo "$WORK_ABS/$name"
}

cmd_record_start() {
  require_up
  local name="${1:-rec.flv}"
  local size; size="$(disp_size)"
  # FLV + low-latency H.264, flushing every packet to disk (-flush_packets 1), so
  # the file is a valid, growing video the whole time it records — watch it live
  # (e.g. ffplay). Without the flush, the muxer buffers and nothing hits disk
  # until the recorder stops.
  docker exec -d -e DISPLAY=:0 "$NAME" sh -c \
    "ffmpeg -y -loglevel error -f x11grab -draw_mouse 1 -video_size $size -framerate 15 -i :0.0 -c:v libx264 -preset veryfast -tune zerolatency -flush_packets 1 -pix_fmt yuv420p /work/$name & echo \$! > /work/${NAME}.pid"
  echo "Recording -> $WORK_ABS/$name (watch it live; stop with: drive-ui-in-docker record-stop)"
}

cmd_record_stop() {
  require_up
  # The .flv is already a complete, valid video at every moment, so stopping is
  # just terminating the recorder — there's no finalization step.
  docker exec "$NAME" sh -c 'p="$1"; test -f "$p" && kill "$(cat "$p")" && rm -f "$p"' _ "/work/${NAME}.pid" \
    || die "no active recording"
  echo "Recording stopped."
}

cmd_run() {
  require_up
  [ "$#" -eq 1 ] || die "run needs exactly one script path"
  local src="$1"
  [ -f "$src" ] || die "no such script: $src"
  # Run with `node`, not the `suchibot` CLI: the CLI auto-starts the input
  # listener, which keeps the process alive. NODE_PATH lets require("suchibot")
  # resolve the global package (also set as the image's ENV).
  local staged=".${NAME}-run.js"
  cat "$src" > "$WORK_ABS/$staged"
  docker exec -e DISPLAY=:0 -e NODE_PATH=/usr/local/lib/node_modules "$NAME" \
    node "/work/$staged"
}

cmd_exec() {
  require_up
  [ "$#" -ge 1 ] || die "exec needs a command"
  docker exec -e DISPLAY=:0 "$NAME" "$@"
}

cmd_shell() {
  require_up
  docker exec -it -e DISPLAY=:0 "$NAME" bash
}

cmd_vncshot() {
  require_up
  local name="${1:-shot.jpg}"
  # Xvnc runs with SecurityTypes=none, so no password is needed. Two quirks:
  #  - the default tight/jpeg encoding negotiation stalls against TigerVNC, so
  #    force a simple encoding (hextile);
  #  - vncsnapshot writes the complete JPEG on the first frame but then loops
  #    without exiting, so bound it with `timeout` and validate the file.
  docker exec "$NAME" sh -c \
    "timeout 15 vncsnapshot -quality 100 -encodings hextile localhost:0 '/work/$name' >/dev/null 2>&1; true"
  docker exec "$NAME" test -s "/work/$name" || die "vncsnapshot produced no image"
  echo "$WORK_ABS/$name"
}

cmd_status() {
  if running; then
    echo "container: $NAME (running)  image: $IMAGE"
    echo "display:   $(disp_size 2>/dev/null || echo '?')"
    echo "view:      http://localhost:8080/"
  elif exists; then
    echo "container: $NAME (stopped — 'up' to resume)"
  else
    echo "container: $NAME (not created)"
  fi
  echo "work dir:  $WORK_ABS"
  ls -1 "$WORK_ABS" 2>/dev/null | sed 's/^/  - /' || true
}

cmd_down() {
  running || { echo "not running"; return 0; }
  docker stop "$NAME" >/dev/null
  echo "Stopped '$NAME' — state preserved. Resume with 'up'; fully remove with 'destroy'."
}

cmd_destroy() {
  exists || { echo "nothing to remove"; return 0; }
  docker rm -f "$NAME" >/dev/null
  echo "Removed '$NAME' (container and everything installed in it is gone)."
}

sub="${1:-}"; shift || true
case "$sub" in
  build)        cmd_build "$@" ;;
  up)           cmd_up "$@" ;;
  launch)       cmd_launch "$@" ;;
  shot)         cmd_shot "$@" ;;
  record-start) cmd_record_start "$@" ;;
  record-stop)  cmd_record_stop "$@" ;;
  run)          cmd_run "$@" ;;
  exec)         cmd_exec "$@" ;;
  shell)        cmd_shell "$@" ;;
  vncshot)      cmd_vncshot "$@" ;;
  status)       cmd_status "$@" ;;
  down)         cmd_down "$@" ;;
  destroy)      cmd_destroy "$@" ;;
  ""|-h|--help|help)
    sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$sub' (try: drive-ui-in-docker help)" ;;
esac
